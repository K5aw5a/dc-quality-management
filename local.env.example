# Settings for this computer. start.cmd copies this file to local.env the
# first time; edit local.env (it is never uploaded to GitHub).
# Lines starting with # are ignored. %LOCALAPPDATA% / %USERPROFILE% work in paths.

# Name shown in the top bar
PROJECT_NAME=Quality Management

# Company logo shown in the top bar and on the sign-in page (.png, .jpg or .svg)
# LOGO_FILE=%USERPROFILE%\Pictures\logo.png

# Where the database lives (default on Windows: %LOCALAPPDATA%\dc-quality\qm.db)
# DB_PATH=%LOCALAPPDATA%\dc-quality\qm.db

# Port the app listens on (default 3000)
# PORT=3000

# OCR language for scanned documents, e.g. en-GB or es-ES (default: your Windows languages)
# OCR_LANG=en-GB
