# Copy to /etc/dc-quality.env (chmod 600). Never commit the real file.
PORT=3000
HOST=127.0.0.1
DB_PATH=/var/lib/dc-quality/qm.db
# Behind nginx with HTTPS:
COOKIE_SECURE=1
TRUST_PROXY=1
# Only used on first start, when no users exist. Remove after the first boot.
# ADMIN_USER=admin
# ADMIN_PASSWORD=change-me-to-something-long
